  "blocks": [
    {
      "id": "power",
      "label": "Power",
      "description": "Supplies regulated 5 V DC power to the board and locally decouples high-frequency switching noise near the microcontroller.",
      "partRefs": ["J1", "C1"],
      "color": "accent-power"
    },
    {
      "id": "mcu",
      "label": "Microcontroller",
      "description": "Digitizes the analog sensor voltage on pin A0 and drives digital output pin D8 to control the LED driver stage.",
      "partRefs": ["U1"],
      "color": "accent-mcu"
    },
    {
      "id": "led-driver",
      "label": "LED driver",
      "description": "Uses an NPN low-side transistor switch and current-limiting resistors to sink about 12.2 mA through the red LED when D8 is HIGH.",
      "partRefs": ["R1", "Q1", "R2", "D1"],
      "color": "accent-driver"
    },
    {
      "id": "sensor-input",
      "label": "Sensor input",
      "description": "Divides the 5 V rail through a 10 kilohm potentiometer to present a variable analog voltage to pin A0.",
      "partRefs": ["RV1"],
      "color": "accent-sensor"
    }
  ],
